# ============================================================
# KONFIGURASI APLIKASI ABSENSI (Flutter)
#
# File ini di-bundle sebagai asset saat build.
# Setelah mengubah isinya: hot restart (R) atau jalankan ulang app.
#
# Sejak integrasi (Okt 2026) server aplikasi = WEBSITE HRD
# (IPM HRIS). Backend Node.js lama sudah tidak dipakai.
# ============================================================

# URL server API website HRD.
# Kosongkan untuk otomatis per platform:
#   - Desktop / Web : http://localhost:8000/api (server dev `php -S localhost:8000 router.php`)
#   - Android       : http://192.168.1.58:8000/api
# Untuk XAMPP/Laragon, isi alamat lengkap folder website, contoh:
#   API_BASE_URL=http://192.168.1.56/ipm-hris/api
API_BASE_URL=

# Daftar kandidat URL server (dipisah koma) untuk deteksi otomatis di jaringan lokal.
API_FALLBACK_IPS=http://192.168.1.58:8000/api,http://10.0.2.2:8000/api,http://192.168.1.18:8000/api,http://192.168.1.12:8000/api,http://192.168.56.1:8000/api,http://localhost:8000/api,http://192.168.1.58/ipm-hris/api,http://localhost/ipm-hris/api

# Timeout request API dalam detik.
API_TIMEOUT_SECONDS=8
